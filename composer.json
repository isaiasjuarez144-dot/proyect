{
  "name": "uyuni-tour/app",
  "description": "Uyuni Tour application",
  "type": "project",
  "require": {
    "php": "^8.3",
    "firebase/php-jwt": "^7.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "UyuniTour\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UyuniTour\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs"
  },
  "config": {
    "sort-packages": true
  }
}
